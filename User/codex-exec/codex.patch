+#[cfg(lixinos)]
+pub async fn resolve_installation_id(codex_home: &AbsolutePathBuf) -> Result<String> {
+    // Import a pre-existing upstream installation ID. On new guest volumes publish
+    // a complete, nonempty directory by atomic rename. Racing initializers cannot
+    // overwrite its ID, and a crash cannot expose a partially written ID.
+    let legacy = codex_home.join(INSTALLATION_ID_FILENAME);
+    let read_id = |path: &std::path::Path| -> Result<Option<String>> {
+        match std::fs::read_to_string(path) {
+            Ok(text) => Ok(Uuid::parse_str(text.trim()).ok().map(|id| id.to_string())),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+            Err(error) => Err(error),
+        }
+    };
+    if let Some(id) = read_id(&legacy)? { return Ok(id); }
+    std::fs::create_dir_all(codex_home)?;
+    let target = codex_home.join("installation_id.lixin");
+    let record = target.join("id");
+    if let Some(id) = read_id(&record)? { return Ok(id); }
+    let id = Uuid::new_v4().to_string();
+    let pending = codex_home.join(format!(".installation-{id}"));
+    std::fs::create_dir(&pending)?;
+    let staged = pending.join("id");
+    let result = std::fs::write(&staged, &id).and_then(|()| std::fs::rename(&pending, &target));
+    if let Err(error) = result {
+        let _ = std::fs::remove_file(&staged);
+        let _ = std::fs::remove_dir(&pending);
+        return read_id(&record)?.ok_or(error);
+    }
+    Ok(id)
+}
