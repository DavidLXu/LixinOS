#!/usr/bin/env bash
set -eu
root=$(cd "$(dirname "$0")/../.." && pwd)
args=()
for arg do
    case "$arg" in
        # musl includes pthreads in libc. The bare-metal GCC driver has no
        # -pthread option, so pass its preprocessor effect explicitly.
        -pthread) args+=(-D_REENTRANT) ;;
        *) args+=("$arg") ;;
    esac
done
exec "$root/Kernel/target/user-build/cpython-port/cc" "${args[@]}"
