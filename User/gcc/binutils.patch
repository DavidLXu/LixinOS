+/* Assemble and link against BFD's seekable memory stream.  Each ordinary
+   file write commits a filesystem snapshot on LixinOS, so publish the
+   completed object with a single atomic file-service operation.  */
+static struct bfd_iovec lixin_output_iovec;
+extern int lx_save_parts (const char *, unsigned long);
+
+static bool
+lixin_publish (bfd *abfd)
+{
+  struct bfd_in_memory *image = abfd->iostream;
+  if (image->size > (100UL << 20))
+    {
+      errno = EFBIG;
+      bfd_set_error (bfd_error_system_call);
+      return false;
+    }
+  uint32_t parts[] = { image->size != 0, 0, (uintptr_t) image->buffer, image->size };
+  uint64_t descriptor = ((uint64_t) (uintptr_t) parts << 32) | image->size;
+  if (lx_save_parts (bfd_get_filename (abfd), descriptor) < 0)
+    {
+      errno = EIO;
+      bfd_set_error (bfd_error_system_call);
+      return false;
+    }
+  return true;
+}
