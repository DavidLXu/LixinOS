+/* Guest BFD writes an entire ELF to this seekable stream. Grow the buffer
+   geometrically so a large link does not copy the whole ELF for each section. */
+static bfd_size_type
+memory_capacity (bfd_size_type size)
+{
+  if (size == 0)
+    return 0;
+  if (size <= 128)
+    return 128;
+  if (size <= (512UL << 20))
+    return 1ULL << (64 - __builtin_clzll (size - 1));
+  return (size + 127) & ~(bfd_size_type) 127;
+}
