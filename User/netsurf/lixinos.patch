+/* The guest transport is synchronous. Queue requests in document order
+ * until the box tree exists, so remote images cannot stall first layout. */
+struct pending_image {
+	struct pending_image *next;
+	nsurl *url;
+	struct box *box;
+	bool background;
+};
+
+static bool drain_images(html_content *c, bool start)
+{
+	bool ok = true;
+	while (c->image_first) {
+		struct pending_image *img = c->image_first;
+		c->image_first = img->next;
+		if (start && ok)
+			ok = html_fetch_object(c, img->url, img->box, CONTENT_IMAGE, img->background);
+		nsurl_unref(img->url);
+		free(img);
+	}
+	c->image_last = NULL;
+	return ok;
+}
+
+bool html_start_pending_images(html_content *c)
+{
+	return drain_images(c, true);
+}
