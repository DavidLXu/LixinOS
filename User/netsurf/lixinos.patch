+/* Entity tokens can be separate adjacent DOM text nodes. Shape and wrap
+ * them together within their common parent, without crossing markup. */
+static dom_exception box_collect_text(dom_node **node, dom_string **out)
+{
+	dom_exception err = dom_characterdata_get_data(*node, out);
+	if (err != DOM_NO_ERR || !*out)
+		return err;
+	size_t length = dom_string_byte_length(*out), capacity = 0;
+	char *buffer = NULL;
+	for (;;) {
+		dom_node *next = NULL;
+		dom_node_type type;
+		err = dom_node_get_next_sibling(*node, &next);
+		if (err != DOM_NO_ERR || !next) break;
+		err = dom_node_get_node_type(next, &type);
+		if (err != DOM_NO_ERR || type != DOM_TEXT_NODE) {
+			dom_node_unref(next);
+			break;
+		}
+		dom_string *part = NULL;
+		err = dom_characterdata_get_data(next, &part);
+		if (err != DOM_NO_ERR || !part) { dom_node_unref(next); break; }
+		size_t add = dom_string_byte_length(part);
+		if (add > SIZE_MAX/2 - length - 1) err = DOM_NO_MEM_ERR;
+		if (err == DOM_NO_ERR && capacity <= length + add) {
+			size_t size = (length + add + 1) * 2;
+			char *tmp = realloc(buffer, size);
+			if (tmp == NULL) err = DOM_NO_MEM_ERR;
+			else {
+				if (!buffer) memcpy(tmp, dom_string_data(*out), length);
+				buffer = tmp;
+				capacity = size;
+			}
+		}
+		if (err == DOM_NO_ERR) {
+			memcpy(buffer + length, dom_string_data(part), add);
+			length += add;
+			dom_node_unref(*node);
+			*node = next;
+		} else dom_node_unref(next);
+		dom_string_unref(part);
+		if (err != DOM_NO_ERR) break;
+	}
+	if (buffer || err != DOM_NO_ERR) {
+		dom_string_unref(*out);
+		*out = NULL;
+		if (err == DOM_NO_ERR)
+			err = dom_string_create((const uint8_t *)buffer, length, out);
+		free(buffer);
+	}
+	return err;
+}
