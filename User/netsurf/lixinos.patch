+/* Inspect each sibling list once; walk the subtree without recursion. */
+static css_error has_descendant_at_index(void *pw, void *root, uint32_t index, bool *match)
+{
+	dom_node *parent = dom_node_ref(root);
+	dom_exception err = DOM_NO_ERR;
+	*match = false;
+	while (parent) {
+		dom_node *child = NULL, *first = NULL, *next = NULL;
+		uint32_t count = 0;
+		err = dom_node_get_first_child(parent, &child);
+		while (!err && child) {
+			dom_node_type type;
+			err = dom_node_get_node_type(child, &type);
+			if (!err && type == DOM_ELEMENT_NODE) {
+				if (!first) first = dom_node_ref(child);
+				*match = (++count == index);
+			}
+			next = NULL;
+			if (!err && !*match) err = dom_node_get_next_sibling(child, &next);
+			dom_node_unref(child);
+			child = next;
+		}
+		if (err || *match) {
+			if (first) dom_node_unref(first);
+			break;
+		}
+		if (first) {
+			dom_node_unref(parent);
+			parent = first;
+			continue;
+		}
+		while (parent != root) {
+			next = NULL;
+			err = dom_node_get_next_sibling(parent, &next);
+			if (!err && !next) {
+				err = dom_node_get_parent_node(parent, &next);
+				dom_node_unref(parent);
+				parent = next;
+				if (!err && parent) continue;
+			} else {
+				dom_node_unref(parent);
+				parent = next;
+			}
+			break;
+		}
+		if (err || parent == root) break;
+	}
+	if (parent) dom_node_unref(parent);
+	return err ? CSS_BADPARM : CSS_OK;
 }
 
