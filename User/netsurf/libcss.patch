+/* A fully transparent top layer leaves the sprite underneath unchanged. */
+static bool next_keyword(const parserutils_vector *v, int32_t *pos,
+		css_token_type type, const char *name)
+{
+	consumeWhitespace(v, pos);
+	const css_token *t = parserutils_vector_iterate(v, pos);
+	return t && t->type == type && lwc_string_length(t->idata) == strlen(name) &&
+			strncasecmp(lwc_string_data(t->idata), name, strlen(name)) == 0;
+}
+
+static bool next_punctuation(const parserutils_vector *v, int32_t *pos, char ch)
+{
+	consumeWhitespace(v, pos);
+	const css_token *t = parserutils_vector_iterate(v, pos);
+	return t && tokenIsChar(t, ch);
+}
+
