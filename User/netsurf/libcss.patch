+	    next_punctuation(v, &pos, ',') &&
+	    next_keyword(v, &pos, CSS_TOKEN_IDENT, "transparent") &&
+	    next_punctuation(v, &pos, ')') && next_punctuation(v, &pos, ',')) {
+		consumeWhitespace(v, &pos);
+		*ctx = pos;
+	}
+}
