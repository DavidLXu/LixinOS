+// Wait for the first byte, then drain only bytes that are already queued.
+static bool fill_buffer_timeout(TermInputBuffer *input, unsigned timeout)
+{
+    size_t previous = input->len;
+    if (!previous) {
+        input->can_be_truncated = false;
+    }
+    while (input->len < TERM_INBUF_SIZE) {
+        int c = lx_timed_byte(timeout);
+        if ((unsigned)c > 255) {
+            break;
+        }
+        input->buf[input->len++] = c;
+        timeout = 0;
+    }
+    return input->len != previous;
+}
