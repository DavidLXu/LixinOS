     add_executable(FreeCADMain WIN32 ${FreeCAD_SRCS})
-    target_link_libraries(FreeCADMain ${FreeCAD_LIBS})
+    find_package(Qt6 REQUIRED COMPONENTS WaylandClient)
+    foreach(plugin IN ITEMS QWaylandIntegrationPlugin QWaylandXdgShellIntegrationPlugin QWaylandEglClientBufferPlugin)
+        if(NOT TARGET Qt6::${plugin})
+            find_package(Qt6${plugin} CONFIG REQUIRED)
+        endif()
+    endforeach()
+    qt_import_plugins(FreeCADMain EXCLUDE_BY_TYPE egldeviceintegrations)
+    qt_import_plugins(FreeCADMain INCLUDE_BY_TYPE platforms Qt6::QWaylandIntegrationPlugin)
+    qt_import_plugins(FreeCADMain INCLUDE_BY_TYPE wayland-shell-integration Qt6::QWaylandXdgShellIntegrationPlugin)
+    qt_import_plugins(FreeCADMain INCLUDE_BY_TYPE wayland-graphics-integration-client Qt6::QWaylandEglClientBufferPlugin)
+    # Built-in Python modules and Qt resource constructors belong to the same process.
+    set(guest_cad_libraries FreeCADBase FreeCADApp FreeCADGui Materials MatGui
+                            Part PartGui Sketcher SketcherGui Measure MeasureGui)
+    target_link_libraries(FreeCADMain ${FreeCAD_LIBS} ${guest_cad_libraries} Qt6::WaylandClient Qt6::QWaylandIntegrationPlugin Qt6::QWaylandIntegrationPlugin_init)
+    foreach(lib IN LISTS guest_cad_libraries)
+        set_property(TARGET FreeCADMain PROPERTY LINK_LIBRARY_OVERRIDE_${lib} WHOLE_ARCHIVE)
+    endforeach()
     if (FREECAD_WARN_ERROR)
         target_compile_warn_error(FreeCADMain)
     endif()
--- a/src/Main/MainGui.cpp
+++ b/src/Main/MainGui.cpp
@@ -130,8 +130,40 @@
     }
 }
 
+#include <Python.h>
+extern "C" {
+PyObject *PyInit__lixin_http();
+PyObject *PyInit__ssl();
+PyObject *PyInit__lixin_process();
+PyObject *PyInit_Materials();
+PyObject *PyInit_MatGui();
+PyObject *PyInit_Part();
+PyObject *PyInit_PartGui();
+PyObject *PyInit_Sketcher();
+PyObject *PyInit_SketcherGui();
+PyObject *PyInit_Measure();
+PyObject *PyInit_MeasureGui();
+}
+
 int main(int argc, char** argv)
 {
+    if (qEnvironmentVariableIsEmpty("QT_QPA_PLATFORM"))
+        qputenv("QT_QPA_PLATFORM", "wayland");
+    static struct _inittab workbenches[] = {
+        {"_lixin_http", PyInit__lixin_http}, {"_ssl", PyInit__ssl},
+        {"_lixin_process", PyInit__lixin_process},
+        {"Materials", PyInit_Materials}, {"MatGui", PyInit_MatGui},
+        {"Part", PyInit_Part}, {"PartGui", PyInit_PartGui},
+        {"Sketcher", PyInit_Sketcher}, {"SketcherGui", PyInit_SketcherGui},
+        {"Measure", PyInit_Measure}, {"MeasureGui", PyInit_MeasureGui},
+        {nullptr, nullptr}
+    };
+    extern int registerGuestBindings();
+    if (registerGuestBindings() < 0 || PyImport_ExtendInittab(workbenches) < 0) {
+        std::fputs("Could not register built-in FreeCAD workbenches\n", stderr);
+        return 1;
+    }
+
 #if defined(FC_OS_LINUX) || defined(FC_OS_BSD)
     setlocale(LC_ALL, "");       // use native environment settings
     setlocale(LC_NUMERIC, "C");  // except for numbers to not break XML import
