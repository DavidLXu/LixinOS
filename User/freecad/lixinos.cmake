# LixinOS's user-mode POSIX adapter uses musl headers and static ELF executables.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
get_filename_component(cache "${CMAKE_CURRENT_LIST_DIR}/../../Kernel/target/user-build" ABSOLUTE)
file(GLOB toolbins "${cache}/arm-gnu-toolchain-*-aarch64-none-elf/bin")
list(GET toolbins 0 toolbin)
set(CMAKE_C_COMPILER "${cache}/gnome-port/cc")
set(CMAKE_CXX_COMPILER "${cache}/gnome-port/cxx")
set(CMAKE_AR "${toolbin}/aarch64-none-elf-ar")
set(CMAKE_RANLIB "${toolbin}/aarch64-none-elf-ranlib")
set(CMAKE_STRIP "${toolbin}/aarch64-none-elf-strip")
set(CMAKE_C_FLAGS_INIT "-D_GNU_SOURCE -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "-D_GNU_SOURCE -ffunction-sections -fdata-sections")
set(CMAKE_FIND_ROOT_PATH ${LIXINOS_EXTRA_ROOTS} "${cache}/freecad-port/sdk" "${cache}/gnome-port/sysroot" "${cache}/gtk3-port/sysroot" "${cache}/cpython-port/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
