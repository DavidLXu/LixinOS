 // based on https://github.com/libsdl-org/SDL_ttf/blob/2a094959055fba09f7deed6e1ffeb986188982ae/SDL_ttf.c#L1735
+/* FreeType faces of different sizes use separate streams but can share the
+ * same open font. The renderer reads synchronously at an explicit offset. */
+typedef struct FontFile {
+  struct FontFile *next;
+  SDL_IOStream *io;
+  unsigned long size;
+  unsigned int references;
+  char path[];
+} FontFile;
+
+static FontFile *font_files;
+
+static FontFile *font_file_open(const char *path) {
+  for (FontFile *resource = font_files; resource; resource = resource->next) {
+    if (!strcmp(resource->path, path)) {
+      resource->references++;
+      return resource;
+    }
+  }
+  SDL_IOStream *io = SDL_IOFromFile(path, "rb");
+  if (!io) return NULL;
+  Sint64 size = SDL_GetIOSize(io);
+  if (size < 0) {
+    SDL_CloseIO(io);
+    return NULL;
+  }
+  FontFile *resource = check_alloc(SDL_malloc(sizeof *resource + strlen(path) + 1));
+  *resource = (FontFile){ .next = font_files, .io = io, .size = size, .references = 1 };
+  strcpy(resource->path, path);
+  font_files = resource;
+  return resource;
+}
+
+static void font_file_release(FontFile *resource) {
+  if (--resource->references) return;
+  FontFile **entry = &font_files;
+  while (*entry != resource) entry = &(*entry)->next;
+  *entry = resource->next;
+  SDL_CloseIO(resource->io);
+  SDL_free(resource);
+}
