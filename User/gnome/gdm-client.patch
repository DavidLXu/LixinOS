         only_headless_allowed = seat == NULL;
 
--- a/libgdm/gdm-user-switching.c
+++ b/libgdm/gdm-user-switching.c
@@ -19,12 +19,20 @@
  *
  */
 
+#ifndef __lixinos__
 #include "common/gdm-common.h"
+#endif
 #include "gdm-user-switching.h"
 
 gboolean
 gdm_goto_login_session_sync (GCancellable  *cancellable,
                              GError       **error)
 {
+#ifdef __lixinos__
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                             "No GDM seat is managing the LixinOS session");
+        return FALSE;
+#else
         return gdm_goto_login_session (cancellable, error);
+#endif
 }
