set(hle "${PC_PORT}/runtime/win32hle")
set(rt "${PC_PORT}/runtime/recomp32")
# HLE uses the installed SDL2/... header layout.
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/include/SDL2")
file(GLOB headers "${SDL_DIR}/include/*.h")
file(COPY ${headers} "${TTF_DIR}/SDL_ttf.h" DESTINATION "${CMAKE_BINARY_DIR}/include/SDL2")
set(ft "$ENV{RA_SDK}/lite-xl-port")
add_library(ra2_ttf STATIC "${TTF_DIR}/SDL_ttf.c")
target_include_directories(ra2_ttf PRIVATE "${ft}/freetype-build/include" "${ft}/freetype-VER-2-14-1/include")
target_link_libraries(ra2_ttf PUBLIC SDL2::SDL2-static "${ft}/freetype-build/libfreetype.a")
file(GLOB hle_sources "${hle}/*.c")
list(FILTER hle_sources EXCLUDE REGEX "_selftest[.]c$")
add_library(ra2_hle STATIC ${hle_sources} recomp/memory.c)
target_include_directories(ra2_hle PUBLIC "${hle}" "${rt}" "${CMAKE_BINARY_DIR}/include")
target_compile_definitions(ra2_hle PUBLIC RECOMP_RETADDR=0u RECOMP_LOCAL_REGS)
target_compile_options(ra2_hle PRIVATE -fno-strict-aliasing -fwrapv)
target_link_libraries(ra2_hle PUBLIC ra2_ttf)
set(host "${RECOMP_DIR}/src/linux")
set(runtime "${RECOMP_DIR}/src/runtime")
set(host_sources "${host}/main.c" "${host}/blowfish.c" "${host}/script.c" "${host}/mods.c" "${host}/menu.c"
      "${runtime}/hdvox.c" "${runtime}/queuefive.c" "${runtime}/gridkeys.c" "${runtime}/bsurface.c")
if(TEST_IMAGE)
add_library(test_host OBJECT ${host_sources} "${TEST_IMAGE}/recomp_0000.c" "${TEST_IMAGE}/recomp_dispatch.c")
target_include_directories(test_host PRIVATE "${host}" "${runtime}" "${TEST_IMAGE}")
target_compile_definitions(test_host PRIVATE main=check_host)
target_compile_options(test_host PRIVATE -fno-strict-aliasing -fwrapv)
target_link_libraries(test_host PRIVATE ra2_hle)
add_executable(ra2-recomp-check $<TARGET_OBJECTS:test_host> recomp/check.c "${hle}/pe_loader_selftest.c" "${hle}/ddraw_selftest.c")
set_source_files_properties("${hle}/pe_loader_selftest.c" PROPERTIES COMPILE_DEFINITIONS "main=check_pe;recomp_dispatch_table=pe_dispatch_table;recomp_dispatch_count=pe_dispatch_count")
set_source_files_properties("${hle}/ddraw_selftest.c" PROPERTIES COMPILE_DEFINITIONS "main=check_draw;recomp_dispatch_table=draw_dispatch_table;recomp_dispatch_count=draw_dispatch_count")
target_link_libraries(ra2-recomp-check PRIVATE ra2_hle)
lixin_display(ra2-recomp-check)
endif()
set(gen "${LIFT_DIR}")
if(EXISTS "${gen}/recomp_dispatch.c")
  file(GLOB lifted CONFIGURE_DEPENDS "${gen}/*.c")
  list(FILTER lifted EXCLUDE REGEX "/[.]_")
  if(PREFLIGHT)
    list(REMOVE_ITEM host_sources "${host}/main.c")
    list(APPEND host_sources "${gen}/preflight-main.c")
    list(REMOVE_ITEM lifted "${gen}/preflight-main.c")
  endif()
  add_executable(ra2-recomp ${host_sources} ${lifted} recomp/start.c)
  target_link_options(ra2-recomp PRIVATE -Wl,--wrap=main)
  if(PREFLIGHT)
    target_compile_definitions(ra2-recomp PRIVATE LX_RA2_PREFLIGHT)
  else()
    target_link_options(ra2-recomp PRIVATE -Wl,--wrap=mods_start)
  endif()
  target_include_directories(ra2-recomp PRIVATE "${host}" "${runtime}" "${gen}")
  target_compile_options(ra2-recomp PRIVATE -fno-strict-aliasing -fwrapv)
  target_link_libraries(ra2-recomp PRIVATE ra2_hle)
  lixin_display(ra2-recomp)
endif()
