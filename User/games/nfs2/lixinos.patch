 static std::string moveToRoot(const std::string& path)
 {
+    // Keep mutable settings, high scores and temporary audio outside the installed assets.
+    if (s_dataDirectory == "/lib/nfs2/game/") {
+        std::string relative = path;
+        std::replace(relative.begin(), relative.end(), '\\', '/');
+        std::transform(relative.begin(), relative.end(), relative.begin(), ::tolower);
+        if (relative.size() >= 2 && relative[1] == ':') relative.erase(0, 2);
+        while (relative.compare(0, 2, "./") == 0) relative.erase(0, 2);
+        while (!relative.empty() && relative.front() == '/') relative.erase(0, 1);
+        for (const char *dir : {"fedata/pc/config/", "fedata/pc/save/", "fedata/pc/stats/",
+                                "gamedata/prefs/", "gamedata/tmptrk/"}) {
+            if (relative.compare(0, strlen(dir), dir) == 0) return "/scratch/nfs2/" + relative;
+        }
+        if (relative == "joycal.cfg") return "/scratch/nfs2/" + relative;
+    }
     if (path.size() >= 2 && path[1] == ':')
     {
         /* Absolute Win32 path (e.g. D:\DATA\...) - map to CD directory */
@@ -326,14 +340,25 @@ x86::reg32 File::seek(x86::reg32 mode, x86::sreg32 offset)
 
 x86::reg32 File::read(void* buffer, x86::reg32 max, x86::reg32* totalRead)
 {
-    *totalRead = ::_read(m_file, buffer, max);
-    return *totalRead != x86::reg32(-1); //*totalRead == max;
+    *totalRead = 0;
+    while (*totalRead < max) {
+        ssize_t n = ::_read(m_file, static_cast<char*>(buffer) + *totalRead, max - *totalRead);
+        if (n < 0) return 0;
+        if (!n) break;
+        *totalRead += n;
+    }
+    return 1;
 }
 
 x86::reg32 File::write(const void* buffer, x86::reg32 max, x86::reg32* totalWritten)
 {
-    *totalWritten = ::_write(m_file, buffer, max);
-    return *totalWritten == max;
+    *totalWritten = 0;
+    while (*totalWritten < max) {
+        ssize_t n = ::_write(m_file, static_cast<const char*>(buffer) + *totalWritten, max - *totalWritten);
+        if (n <= 0) return 0;
+        *totalWritten += n;
+    }
+    return 1;
 }
 
