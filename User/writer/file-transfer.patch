+#ifdef __lixinos__
+// A guest syscall can transfer only one mailbox (4096 bytes) at a time.
+static ssize_t guestFileTransfer(int fd, void *data, size_t size, off_t offset, bool writing)
+{
+    size_t done = 0;
+    while (done < size) {
+        char *buf = static_cast<char *>(data) + done;
+        ssize_t n = writing ? ::pwrite(fd, buf, size - done, offset + done)
+                            : ::pread(fd, buf, size - done, offset + done);
+        if (n < 0 && errno == EINTR) continue;
+        if (n < 0) return -1;
+        if (n == 0) break;
+        done += n;
+    }
+    return done;
+}
+#endif
