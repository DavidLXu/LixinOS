+// getVtables() holds the factory mutex while constructing and publishing the vtable.
+const unsigned char * staticSlot(sal_Int32 function, sal_Int32 offset)
+{
+    static unsigned count;
+    unsigned i = 0;
+    while (i < count && (lx_writer_uno_arguments[i][0] != function ||
+                         lx_writer_uno_arguments[i][1] != offset))
+        ++i;
+    if (i == count) {
+        if (count == 8192) throw std::bad_alloc();
+        lx_writer_uno_arguments[i][0] = function;
+        lx_writer_uno_arguments[i][1] = offset;
+        ++count;
+    }
+    return lx_writer_uno_slots + i * 8;
+}
