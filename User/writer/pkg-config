#!/usr/bin/env bash
set -eu
sdk=$(cd "$(dirname "$0")/../../Kernel/target/user-build" && pwd)
# Cross projects such as CoinMP advertise sibling build trees through this path.
# Only take metadata for the guest, even when Homebrew exports PKG_CONFIG_PATH.
IFS=: read -ra roots <<< "${PKG_CONFIG_PATH:-}"
export PKG_CONFIG_PATH=
for candidate in "${roots[@]:-}"; do
    [[ -d "$candidate" ]] || continue
    dir=$(cd "$candidate" && pwd -P)
    case "$dir/" in "$sdk/"*) PKG_CONFIG_PATH="${PKG_CONFIG_PATH:+$PKG_CONFIG_PATH:}$dir";; esac
done
export PKG_CONFIG_LIBDIR="$sdk/gtk3-port/sysroot/lib/pkgconfig:$sdk/gnome-port/sysroot/lib/pkgconfig:$sdk/cpython-port/sysroot/lib/pkgconfig"
exec pkg-config "$@"
